# Generated by Terraform (infra/main.tf); deleted by `terraform destroy`.
#
#   ssh -F infra/.state/ssh_config server
#
# Each instance answers to its role and to its public address. Its host key is
# remembered under its instance ID, so an address AWS hands out again later
# does not clash with an instance gone.
%{ for role, instance in instances ~}

Host ${role} ${instance.public_ip}
    HostName ${instance.public_ip}
    HostKeyAlias ${instance.id}
%{ endfor ~}

Host *
    User ubuntu
    IdentityFile ${state}/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ${state}/known_hosts
    StrictHostKeyChecking accept-new
    ConnectTimeout 5
    ServerAliveInterval 15
    LogLevel ERROR
    # One connection per host, reused by every command of a run.
    ControlMaster auto
    ControlPath ${state}/cm-%C
    ControlPersist 10m
